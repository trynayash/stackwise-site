{
  "name": "stackwise-brand-film",
  "version": "1.0.0",
  "private": true,
  "description": "StackWise brand film, built with Remotion. Separate from the website build.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:vertical": "remotion render src/index.ts Vertical out/stackwise-brand-film-9x16.mp4",
    "render:horizontal": "remotion render src/index.ts Horizontal out/stackwise-brand-film-16x9.mp4",
    "stills": "remotion still src/index.ts Vertical out/poster-9x16.png --frame=1300 && remotion still src/index.ts Horizontal out/thumbnail-16x9.png --frame=500",
    "audio": "python3 -I tools/make-audio.py && python3 -I tools/make-music.py",
    "typecheck": "tsc -p tsconfig.json",
    "voice": "python3 -I tools/make-voice.py --model models --voice af_heart",
    "captions": "python3 -I tools/make-captions.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "^4.0.540",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
